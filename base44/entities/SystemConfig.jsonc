{
  "name": "SystemConfig",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Chave de configura\u00e7\u00e3o (ex: twilio_account_sid, smtp_host)"
    },
    "config_value": {
      "type": "string",
      "description": "Valor da configura\u00e7\u00e3o"
    },
    "config_type": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "general"
      ],
      "description": "Tipo da configura\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da configura\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a configura\u00e7\u00e3o est\u00e1 ativa"
    }
  },
  "required": [
    "config_key",
    "config_value",
    "config_type"
  ]
}